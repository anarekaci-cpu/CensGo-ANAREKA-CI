# Supabase Configuration
VITE_SUPABASE_URL=https:
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_TABLE=census_points

# Gemini AI (clé serveur, non exposée au navigateur)
GEMINI_API_KEY=
# Origines autorisées pour l'Edge Function IA, séparées par des virgules.
# Exemple : https://anarekaci-cpu.github.io,http://localhost:3000
AI_ALLOWED_ORIGINS=https://anarekaci-cpu.github.io

# Map Configuration (Cocody, Abidjan — siège ANAREKA-CI)
VITE_MAP_CENTER_LAT=5.3724499
VITE_MAP_CENTER_LNG=-3.9676843
VITE_MAP_ZOOM=12

# OSRM Routing (repli hors-ligne / si VITE_ORS_API_KEY n'est pas définie)
VITE_OSRM_URL=https://router.project-osrm.org

# OpenRouteService — itinéraires réels par mode piéton/vélo/voiture.
# Clé gratuite : https://openrouteservice.org/dev/#/signup (2000 req/jour)
VITE_ORS_API_KEY=
VITE_ORS_URL=https://api.openrouteservice.org

# Trafic heuristique : facteur de ralentissement voiture aux heures de
# pointe Abidjan/Bingerville (7h-9h, 17h-19h). 1 = pas de ralentissement.
VITE_TRAFFIC_RUSH_HOUR_FACTOR=1.6

# Application
VITE_APP_NAME=Recensement ANAREKA
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production

# Features
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_TOUR_OPTIMIZATION=true

# Navigation
VITE_ARRIVAL_RADIUS_M=30

# Anti-fraude : distance max (m) entre l'agent et un point pour le marquer visité
VITE_VISIT_GEOFENCE_RADIUS_M=500
