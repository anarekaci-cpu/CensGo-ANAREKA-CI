# ============================================
# Recensement ANAREKA-CI — Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez vos valeurs
# NEVER commit .env to Git!

# --- Supabase ---
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# --- OSRM Routing ---
# Instance publique par défaut (limite de requêtes)
VITE_OSRM_URL=https://router.project-osrm.org
# Pour une instance privée, décommentez :
# VITE_OSRM_URL=http://localhost:5000

# --- Application ---
VITE_APP_NAME=Recensement ANAREKA
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development

# --- Features ---
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_TOUR_OPTIMIZATION=true
