# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_TABLE=census_points

# Gemini AI (clé serveur, non exposée au navigateur)
GEMINI_API_KEY=

# Map Configuration (Cocody, Abidjan — siège ANAREKA-CI)
VITE_MAP_CENTER_LAT=5.3724499
VITE_MAP_CENTER_LNG=-3.9676843
VITE_MAP_ZOOM=12

# OSRM Routing
VITE_OSRM_URL=https://router.project-osrm.org

# Application
VITE_APP_NAME=Recensement ANAREKA
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production

# Features
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_TOUR_OPTIMIZATION=true

# Navigation
VITE_ARRIVAL_RADIUS_M=30
