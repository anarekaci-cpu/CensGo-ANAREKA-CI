# Supabase Configuration
# Remplacer par vos vraies valeurs (NE JAMAIS committer .env)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Application
VITE_APP_NAME="Recensement ANAREKA-CI"
VITE_APP_VERSION="1.0.0"

# Carte
VITE_MAP_CENTER_LAT=5.355
VITE_MAP_CENTER_LNG=-3.88
VITE_MAP_ZOOM=13

# Routing OSRM (laisser vide pour utiliser le public, ou mettre votre instance)
VITE_OSRM_URL=https://router.project-osrm.org
