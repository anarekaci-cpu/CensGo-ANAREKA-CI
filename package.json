{
  "name": "recensement-anareka-ci",
  "version": "2.0.0",
  "description": "Application PWA de recensement terrain ANAREKA-CI — Vite + IndexedDB",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dexie": "^4.0.8",
    "maplibre-gl": "^4.7.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "gh-pages": "^6.1.1",
    "jsdom": "^30.0.1",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.11"
  }
}
